# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://razorledger:razorledger@localhost:5432/razorledger

# For Neon (demo): replace with your Neon connection string
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/razorledger?sslmode=require

GEMINI_API_KEY=your-gemini-api-key-here

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
